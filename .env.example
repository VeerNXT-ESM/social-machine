# VeerNXT Social - Environment Configuration Example
# Copy this file to .env.local for local development

# ==================================================
# 1. OPENAI API CONFIGURATION
# ==================================================
# Required for live AI content generation and single-platform refinements.
# If not provided, the application falls back to built-in high quality mock generator.
OPENAI_API_KEY=your_openai_api_key_here

# ==================================================
# 2. SUPABASE CONFIGURATION
# ==================================================
# Required for Supabase authentication, Database (RLS), and Media Storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
# Session pooler (IPv4). URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ==================================================
# 3. PUBLISHING INTEGRATIONS (OPTIONAL)
# ==================================================
# Buffer integration: publishes to LinkedIn and X (create the key at publish.buffer.com/settings/api)
BUFFER_API_KEY=your_buffer_access_token_here

# Meta Graph API for Facebook & Instagram (Optional)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_page_access_token

# LinkedIn REST API (Optional)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# X (Twitter) API v2 (Optional)
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_BEARER_TOKEN=your_x_bearer_token

# Application Environment Mode
NEXT_PUBLIC_APP_MODE=mock

# Sign-in is always required on the online site (production build) and off for local development.
# Set to true to try the sign-in locally.
# REQUIRE_SIGN_IN=true
